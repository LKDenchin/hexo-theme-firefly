<% if (theme.music && theme.music.mode !== 'none') { %>
<div class="widget music-widget">
  <div class="widget-header">
    <span class="material-symbols-outlined">library_music</span>
    <span><%= __('music') %></span>
  </div>
  <div class="widget-body">
    <% if (theme.music.mode === 'meting' && theme.music.meting) { %>
      <meting-js
        server="<%= theme.music.meting.server || 'netease' %>"
        type="<%= theme.music.meting.type || 'playlist' %>"
        id="<%= theme.music.meting.id || '' %>"
        api="<%= theme.music.meting.api || 'https://api.injahow.cn/meting/?server=:server&type=:type&id=:id&r=:r' %>"
        order="<%= theme.music.play_mode || 'list' %>"
        fixed="false"
        mini="false"
        autoplay="false"
        theme="var(--primary)"
        loop="all"
        preload="auto"
        volume="<%= (theme.music.volume || 0.7) %>"
        mutex="true">
      </meting-js>
    <% } else if (theme.music.mode === 'local' && theme.music.local && theme.music.local.playlist) { %>
      <div id="aplayer-local" class="aplayer"></div>
      <script>
        window.__LOCAL_PLAYLIST = <%- JSON.stringify(theme.music.local.playlist) %>;
      </script>
    <% } %>
  </div>
</div>

<script>
(function() {
  function bindAPlayer(ap) {
    if (!ap) return;

    function getAPInstance() {
      if (ap.aplayer) return ap.aplayer;
      if (window.aplayers && window.aplayers.length > 0) {
        for (var i = 0; i < window.aplayers.length; i++) {
          if (window.aplayers[i].container === ap || ap.contains(window.aplayers[i].container)) {
            return window.aplayers[i];
          }
        }
        return window.aplayers[0];
      }
      return null;
    }

    // Ensure cover image is circular
    var pic = ap.querySelector('.aplayer-pic');
    if (pic) pic.style.borderRadius = '50%';

    // Inject or query custom control bar
    var controls = ap.querySelector('.custom-music-controls');
    if (!controls) {
      controls = document.createElement('div');
      controls.className = 'custom-music-controls';
      controls.innerHTML = `
        <button class="music-ctrl-btn music-btn-mode" title="切换模式" type="button">
          <span class="material-symbols-outlined">repeat</span>
        </button>
        <button class="music-ctrl-btn music-btn-prev" title="上一首" type="button">
          <span class="material-symbols-outlined">skip_previous</span>
        </button>
        <button class="music-ctrl-btn music-btn-play" title="播放/暂停" type="button">
          <span class="material-symbols-outlined play-icon">play_arrow</span>
        </button>
        <button class="music-ctrl-btn music-btn-next" title="下一首" type="button">
          <span class="material-symbols-outlined">skip_next</span>
        </button>
        <button class="music-ctrl-btn music-btn-list" title="播放列表" type="button">
          <span class="material-symbols-outlined">queue_music</span>
        </button>
      `;
      var body = ap.querySelector('.aplayer-body');
      if (body) body.appendChild(controls);
    }

    var playBtn = controls.querySelector('.music-btn-play');
    var playIcon = playBtn.querySelector('.play-icon');

    function syncPlayState() {
      // Keep play_arrow triangle icon matching mockup 2
      playIcon.textContent = 'play_arrow';
    }

    playBtn.onclick = function(e) {
      e.preventDefault();
      e.stopPropagation();
      var apInst = getAPInstance();
      if (apInst) {
        apInst.toggle();
      } else {
        var audio = ap.querySelector('audio');
        if (audio) {
          if (audio.paused) audio.play(); else audio.pause();
        } else {
          var origBtn = ap.querySelector('.aplayer-button');
          if (origBtn) origBtn.click();
        }
      }
      syncPlayState();
    };

    controls.querySelector('.music-btn-prev').onclick = function(e) {
      e.preventDefault();
      e.stopPropagation();
      var apInst = getAPInstance();
      if (apInst) {
        apInst.skipBack();
      } else {
        var btn = ap.querySelector('.aplayer-icon-back, .aplayer-skip-back');
        if (btn) btn.click();
      }
    };

    controls.querySelector('.music-btn-next').onclick = function(e) {
      e.preventDefault();
      e.stopPropagation();
      var apInst = getAPInstance();
      if (apInst) {
        apInst.skipForward();
      } else {
        var btn = ap.querySelector('.aplayer-icon-forward, .aplayer-skip-forward');
        if (btn) btn.click();
      }
    };

    controls.querySelector('.music-btn-list').onclick = function(e) {
      e.preventDefault();
      e.stopPropagation();
      var list = ap.querySelector('.aplayer-list');
      if (list) {
        list.classList.toggle('aplayer-list-show');
      }
    };

    var modeBtn = controls.querySelector('.music-btn-mode');
    var currentModeIndex = 0; // 0: list loop, 1: single loop, 2: shuffle

    modeBtn.onclick = function(e) {
      e.preventDefault();
      e.stopPropagation();
      var apInst = getAPInstance();
      currentModeIndex = (currentModeIndex + 1) % 3;

      var modeIcon = this.querySelector('.material-symbols-outlined');
      var audio = ap.querySelector('audio');

      if (currentModeIndex === 1) {
        // Mode 1: Single Loop (单曲循环)
        if (apInst) {
          apInst.options.loop = 'one';
          apInst.options.order = 'list';
          if (apInst.notice) apInst.notice('播放模式: 单曲循环');
        }
        if (audio) audio.loop = true;
        if (modeIcon) modeIcon.textContent = 'repeat_one';
        this.title = '单曲循环';
      } else if (currentModeIndex === 2) {
        // Mode 2: Shuffle (随机播放)
        if (apInst) {
          apInst.options.loop = 'all';
          apInst.options.order = 'random';
          if (apInst.notice) apInst.notice('播放模式: 随机播放');
        }
        if (audio) audio.loop = false;
        if (modeIcon) modeIcon.textContent = 'shuffle';
        this.title = '随机播放';
      } else {
        // Mode 0: List Loop (列表循环)
        if (apInst) {
          apInst.options.loop = 'all';
          apInst.options.order = 'list';
          if (apInst.notice) apInst.notice('播放模式: 列表循环');
        }
        if (audio) audio.loop = false;
        if (modeIcon) modeIcon.textContent = 'repeat';
        this.title = '列表循环';
      }

      var origMode = ap.querySelector('.aplayer-icon-mode');
      if (origMode) origMode.click();
    };

    var audio = ap.querySelector('audio');
    if (audio) {
      audio.removeEventListener('play', syncPlayState);
      audio.removeEventListener('pause', syncPlayState);
      audio.addEventListener('play', syncPlayState);
      audio.addEventListener('pause', syncPlayState);
    }
  }

  function initAll() {
    document.querySelectorAll('.music-widget .aplayer').forEach(bindAPlayer);
  }

  var observer = new MutationObserver(function() {
    initAll();
  });
  observer.observe(document.body, { childList: true, subtree: true });

  document.addEventListener('DOMContentLoaded', initAll);
  document.addEventListener('pjax:complete', initAll);
  initAll();
})();
</script>
<% } %>
