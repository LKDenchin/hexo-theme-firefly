<% if (theme.music && theme.music.mode !== 'none') { %>
<div class="widget music-widget">
  <div class="widget-header">
    <span class="material-symbols-outlined">library_music</span>
    <span><%= __('music') %></span>
  </div>
  <div class="widget-body">
    <% if (theme.music.mode === 'meting' && theme.music.meting) { %>
      <meting-js
        server="<%= theme.music.meting.server || 'netease' %>"
        type="<%= theme.music.meting.type || 'playlist' %>"
        id="<%= theme.music.meting.id || '' %>"
        api="<%= theme.music.meting.api || 'https://api.injahow.cn/meting/?server=:server&type=:type&id=:id&r=:r' %>"
        order="<%= theme.music.play_mode || 'list' %>"
        fixed="false"
        mini="false"
        autoplay="false"
        theme="var(--primary)"
        loop="all"
        preload="auto"
        volume="<%= (theme.music.volume || 0.7) %>"
        mutex="true">
      </meting-js>
    <% } else if (theme.music.mode === 'local' && theme.music.local && theme.music.local.playlist) { %>
      <div id="aplayer-local" class="aplayer"></div>
      <script>
        window.__LOCAL_PLAYLIST = <%- JSON.stringify(theme.music.local.playlist) %>;
      </script>
    <% } %>
  </div>
</div>

<script>
(function() {
  function setupCustomControls(ap) {
    if (!ap || ap.dataset.customControlsInited) return;
    ap.dataset.customControlsInited = '1';

    // Ensure cover image is circular
    var pic = ap.querySelector('.aplayer-pic');
    if (pic) pic.style.borderRadius = '50%';

    // Build custom control bar matching mockup
    var controls = document.createElement('div');
    controls.className = 'custom-music-controls';
    controls.innerHTML = `
      <button class="music-ctrl-btn music-btn-mode" title="切换模式" type="button">
        <span class="material-symbols-outlined">repeat</span>
      </button>
      <button class="music-ctrl-btn music-btn-prev" title="上一首" type="button">
        <span class="material-symbols-outlined">skip_previous</span>
      </button>
      <button class="music-ctrl-btn music-btn-play" title="播放/暂停" type="button">
        <span class="material-symbols-outlined play-icon">play_arrow</span>
      </button>
      <button class="music-ctrl-btn music-btn-next" title="下一首" type="button">
        <span class="material-symbols-outlined">skip_next</span>
      </button>
      <button class="music-ctrl-btn music-btn-list" title="播放列表" type="button">
        <span class="material-symbols-outlined">queue_music</span>
      </button>
    `;

    var body = ap.querySelector('.aplayer-body');
    if (body) body.appendChild(controls);

    var getAP = function() {
      return ap.aplayer || (window.aplayers && window.aplayers[0]);
    };

    controls.querySelector('.music-btn-prev').addEventListener('click', function(e) {
      e.stopPropagation();
      var inst = getAP();
      if (inst) inst.skipBack();
    });

    controls.querySelector('.music-btn-next').addEventListener('click', function(e) {
      e.stopPropagation();
      var inst = getAP();
      if (inst) inst.skipForward();
    });

    var playBtn = controls.querySelector('.music-btn-play');
    playBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      var inst = getAP();
      if (inst) {
        inst.toggle();
      } else {
        var origPlay = ap.querySelector('.aplayer-button');
        if (origPlay) origPlay.click();
      }
    });

    controls.querySelector('.music-btn-list').addEventListener('click', function(e) {
      e.stopPropagation();
      var list = ap.querySelector('.aplayer-list');
      if (list) list.classList.toggle('aplayer-list-hide');
    });

    controls.querySelector('.music-btn-mode').addEventListener('click', function(e) {
      e.stopPropagation();
      var origBtn = ap.querySelector('.aplayer-icon-mode');
      if (origBtn) origBtn.click();
    });

    function updateState() {
      var icon = playBtn.querySelector('.play-icon');
      var audio = ap.querySelector('audio');
      if (icon && audio) {
        icon.textContent = audio.paused ? 'play_arrow' : 'pause';
      }
    }

    var audio = ap.querySelector('audio');
    if (audio) {
      audio.addEventListener('play', updateState);
      audio.addEventListener('pause', updateState);
      updateState();
    }
  }

  function initWidget(widgetBody) {
    var observer = new MutationObserver(function() {
      var ap = widgetBody.querySelector('.aplayer');
      if (ap) setupCustomControls(ap);
    });
    observer.observe(widgetBody, { childList: true, subtree: true });

    var existing = widgetBody.querySelector('.aplayer');
    if (existing) setupCustomControls(existing);
  }

  document.querySelectorAll('.music-widget .widget-body').forEach(initWidget);
})();
</script>
<% } %>
