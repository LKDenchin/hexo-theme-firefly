<%
/**
 * Tags cloud & rank chart page matching design mockup.
 */
var sidebar = theme.sidebar || {};
var sidebarPosition = sidebar.position || 'both';
var showLeftSidebar = sidebarPosition === 'both' || sidebarPosition === 'left';
var showRightSidebar = sidebarPosition === 'both' || sidebarPosition === 'right';
var gridClass = 'has-no-sidebar';
if (showLeftSidebar && showRightSidebar) {
  gridClass = 'has-both-sidebars';
} else if (showLeftSidebar) {
  gridClass = 'has-left-sidebar';
} else if (showRightSidebar) {
  gridClass = 'has-right-sidebar';
}

var allTags = [];
if (site.tags && site.tags.length > 0) {
  allTags = site.tags.toArray().filter(function(tag) {
    return tag.posts && tag.posts.length > 0;
  });
  allTags.sort(function(a, b) {
    return b.posts.length - a.posts.length;
  });
}
var top10Tags = allTags.slice(0, 10);
var maxCount = (top10Tags.length > 0 && top10Tags[0].posts) ? top10Tags[0].posts.length : 1;
%>

<div id="main-grid" class="main-grid-layout <%= gridClass %>">
  <!-- ===== Left Sidebar ===== -->
  <% if (showLeftSidebar) { %>
  <aside class="sidebar-left" aria-label="<%= __('sidebar.left') %>">
    <%- partial('_partials/post/sidebar-left') %>
  </aside>
  <% } %>

  <!-- ===== Main Content ===== -->
  <main id="main-content" class="tags-container">
    <%- partial('_partials/post/content-nav') %>

    <!-- Header Card -->
    <div class="tags-header-card card-base">
      <h1 class="tags-header-title">标签</h1>
      <p class="tags-header-subtitle">全部标签 · <%= site.tags.length %> 个标签</p>
    </div>

    <!-- Tag Cloud Pill Box Card -->
    <div class="tags-cloud-card card-base">
      <div class="tags-cloud-list">
        <% if (allTags.length > 0) { %>
          <% allTags.forEach(function(tag, index) { %>
          <a href="<%= url_for(tag.path) %>" class="tag-cloud-pill<%= index === 0 ? ' active' : '' %>">
            <span class="tag-pill-name"><%= tag.name %></span>
            <span class="tag-pill-badge"><%= tag.posts.length %></span>
          </a>
          <% }); %>
        <% } else { %>
        <p class="tags-empty"><%= __('tag.empty') %></p>
        <% } %>
      </div>
    </div>

    <!-- Top 10 Tags Rank Card -->
    <% if (top10Tags.length > 0) { %>
    <div class="tags-rank-card card-base">
      <h2 class="tags-rank-title">Top 10</h2>
      <div class="tags-rank-list">
        <% top10Tags.forEach(function(tag, index) {
          var count = tag.posts ? tag.posts.length : 1;
          var percent = Math.min(100, Math.max(12, (count / maxCount) * 100));
        %>
        <div class="tag-rank-item">
          <span class="rank-num"><%= index + 1 %></span>
          <a href="<%= url_for(tag.path) %>" class="rank-name">#<%= tag.name %></a>
          <div class="rank-track">
            <div class="rank-bar" style="width: <%= percent.toFixed(1) %>%;"></div>
          </div>
          <span class="rank-count"><%= count %> 篇文章</span>
        </div>
        <% }); %>
      </div>
    </div>
    <% } %>
  </main>

  <!-- ===== Right Sidebar ===== -->
  <% if (showRightSidebar) { %>
  <aside class="sidebar-right" aria-label="<%= __('sidebar.right') %>">
    <%- partial('_partials/post/sidebar-right') %>
  </aside>
  <% } %>

  <!-- ===== Mobile Bottom Sidebar ===== -->
  <%- partial('_partials/post/mobile-sidebar') %>

  <%- partial('_partials/footer') %>
</div>
